#!/bin/sh /etc/rc.common

# Creates the xfrm interface an IKEv2 CHILD_SA surfaces on.
#
# Everything about the device -- its name, if_id, on-link address, MTU and
# parent -- lives in `gotun ipsec`, which reads them from gotun.conf. This file
# only says when.
#
# START is before strongswan (90) and gotun (99), so the device exists before
# anything wants to use it. STOP=11 is after gotun's 10, so the policy is
# withdrawn before the device it steers into is removed.

START=89
STOP=11

CONF=/etc/gotun/gotun.conf

start() {
	/usr/bin/gotun ipsec up -config "$CONF"
}

stop() {
	/usr/bin/gotun ipsec down -config "$CONF"
}
