#!/bin/sh /etc/rc.common
#
# gotun-dns splits DNS the same way gotun splits routing: names that belong to
# the direct class are resolved by a local resolver, everything else is resolved
# through the tunnel.
#
# This matters more than it looks. Resolving a foreign name from here without the
# tunnel does not merely give a slower answer, it gives a *different* one --
# geo-localised at best, interfered with at worst (a direct query to a foreign
# resolver here returns an address and NXDOMAIN in the same reply). Routing the
# query through the tunnel is what makes the address the client connects to the
# right one.
#
# It listens on 127.0.0.2:53 rather than :53 because dnsmasq owns :53 on this box
# and also serves DHCP. dnsmasq forwards to it.

START=97
STOP=12

USE_PROCD=1

CONF=/etc/gotun/gotun-dns.conf

start_service() {
	[ -f "$CONF" ] && . "$CONF"

	procd_open_instance
	procd_set_param command /usr/bin/gotun-dns \
		-listen "${GOTUN_DNS_LISTEN:-127.0.0.2:53}" \
		-direct-upstream "${GOTUN_DNS_DIRECT:-77.88.8.8:53}" \
		-exit-upstream "${GOTUN_DNS_EXIT:-1.1.1.1:53}" \
		-mark "${GOTUN_DNS_MARK:-0x1}"
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
