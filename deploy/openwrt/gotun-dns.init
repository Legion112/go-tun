#!/bin/sh /etc/rc.common
#
# gotun-dns splits DNS the same way gotun splits routing: names that belong to
# the direct class are resolved by a local resolver, everything else is resolved
# through the tunnel.
#
# This matters more than it looks. Resolving a foreign name from here without the
# tunnel does not merely give a slower answer, it gives a *different* one --
# geo-localised at best, interfered with at worst (a direct query to a foreign
# resolver here returns an address and NXDOMAIN in the same reply). Routing the
# query through the tunnel is what makes the address the client connects to the
# right one.
#
# Every setting lives in $CONF, and the file is optional because all of them
# have defaults -- including the listen address, which is 127.0.0.2:53 in the
# binary itself rather than a fallback in this script. That used to be the one
# thing keeping this off dnsmasq's port, and it lived only here, where the
# binary could not see it.

START=97
STOP=12

USE_PROCD=1

CONF=/etc/gotun/gotun-dns.conf

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/gotun-dns
	# Passed only when it exists, so a box without the file starts on defaults
	# rather than refusing -- while a -config naming a path that is not there
	# stays a hard error, which is what catches a typo in the path.
	[ -f "$CONF" ] && procd_append_param command -config "$CONF"
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_set_param file "$CONF"
	procd_close_instance
}
