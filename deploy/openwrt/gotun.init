#!/bin/sh /etc/rc.common
#
# gotun watch converges the policy once and then keeps table 100 honest about
# whether the tunnel is actually carrying traffic.
#
# This is supervised, unlike the earlier one-shot apply. The one-shot could not
# notice a tunnel that was up but dead, which is exactly how an outage went
# unnoticed for its whole duration: the route stayed pointing into a tunnel that
# swallowed every packet, and nothing was watching.
#
# START is late because the route needs the tunnel device to exist first. If it
# does not yet, the apply still installs the classifier and leaves table 100
# empty, which under fail-open means traffic uses the uplink -- degraded, not
# broken -- until the transport comes up and the watchdog restores the route.

START=99
STOP=10

USE_PROCD=1

CONF=/etc/gotun/gotun.conf

start_service() {
	if [ ! -f "$CONF" ]; then
		echo "gotun: $CONF is missing; refusing to guess a policy" >&2
		return 1
	fi
	# shellcheck source=/dev/null
	. "$CONF"

	if [ ! -f "$GOTUN_PREFIXES" ]; then
		echo "gotun: prefix list $GOTUN_PREFIXES is missing; refusing to apply" >&2
		return 1
	fi

	procd_open_instance
	procd_set_param command /usr/bin/gotun watch \
		-prefixes "$GOTUN_PREFIXES" \
		-endpoint "$GOTUN_ENDPOINT" \
		-tunnel-iface "${GOTUN_TUNNEL_IFACE:-wg-exit}" \
		-lan "$GOTUN_LAN" \
		-mark-iface "$GOTUN_MARK_IFACE" \
		-clients-iface "$GOTUN_CLIENTS_IFACE" \
		-direct-src "$GOTUN_DIRECT_SRC" \
		-fail-mode "${GOTUN_FAIL_MODE:-open}" \
		-ipv6 "${GOTUN_IPV6:-auto}" \
		-ipv6-fallback "${GOTUN_IPV6_FALLBACK:-direct}" \
		-probe-target "${GOTUN_PROBE_TARGET:-1.1.1.1:443}" \
		-probe-interval "${GOTUN_PROBE_INTERVAL:-60s}" \
		-fail-after "${GOTUN_FAIL_AFTER:-3}" \
		-recover-after "${GOTUN_RECOVER_AFTER:-2}" \
		-health-listen "$GOTUN_HEALTH_LISTEN"
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_set_param file "$CONF"
	procd_close_instance
}

stop_service() {
	# rc.common runs this *before* procd_kill, so the watcher is still alive
	# while clear runs -- measured in the deploy lab, and the opposite of what
	# this comment used to claim. A tunnel transition inside that window has the
	# watcher re-apply the policy clear has just removed, leaving the box
	# steered into a table with no supervisor. Narrow, but real, and the reason
	# the refactor should have the watcher do its own teardown on SIGTERM
	# rather than have a second process race it.
	/usr/bin/gotun clear
}
