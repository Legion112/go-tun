#!/bin/sh /etc/rc.common
#
# gotun dnswatch keeps dnsmasq's upstream list down to the resolvers that are
# answering. The chain is dnsmasq -> AdGuard Home -> gotun-dns -> Direct/Exit,
# with a local resolver last, and dnsmasq reads it from a --servers-file this
# service owns.
#
# Without it the chain still works, but slowly when a hop dies: dnsmasq only
# moves down the list when a client retries, so with AdGuard Home down or hung
# every uncached lookup on the LAN stalled for about 2 s (measured, strict-order
# on). With it, a dead hop is out of the list within two probes and back in
# after three answered ones. Ad blocking is what degrades; resolution does not.
#
# It reads the same file as gotun-dns: GOTUN_DNS_LISTEN is the resolver it
# probes and GOTUN_DNS_DIRECT the last resort, so the two cannot disagree about
# which resolver is running.
#
# START after gotun-dns, which it probes, but before gotun, which the ordering
# test requires of everything gotun routes alongside. STOP before gotun-dns: on
# the way down it writes the full list back, and the full list is what dnsmasq
# should be left with when nothing is watching.

START=98
STOP=11

USE_PROCD=1

CONF=/etc/gotun/gotun-dns.conf

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/gotun dnswatch
	[ -f "$CONF" ] && procd_append_param command -config "$CONF"
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_set_param file "$CONF"
	procd_close_instance
}
