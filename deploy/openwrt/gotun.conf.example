# Sourced by /etc/init.d/gotun. Shell syntax, no export needed.

# Collapsed CIDR list of destinations that go direct, out the ISP.
GOTUN_PREFIXES=/etc/gotun/prefixes.txt

# Underlay address(es) of the WireGuard peer, excluded from marking so the
# tunnel cannot try to carry its own handshake. Comma-separated: a dual-stack
# peer reachable over both families needs both listed, or the IPv6 classifier
# marks the tunnel's own encapsulated packets.
# Both the XRay server and any other tunnel endpoint must be listed, or the
# router will classify a neighbouring tunnel's own packets and route them into
# this one. Comma-separated.
GOTUN_ENDPOINT=185.80.130.211

# The tun sing-box creates.
GOTUN_TUNNEL_IFACE=xray0

# Local CIDRs, excluded from marking. List the IPv6 prefix here too once the
# LAN has one, or inbound WireGuard peers are not isolated from it.
GOTUN_LAN=192.168.8.0/24

# Only classify traffic arriving on these interfaces. Leaving this empty
# classifies traffic from ANY interface, including WAN-inbound. Add br-iot or a
# guest bridge here the day it is enabled, or those clients silently get no
# split routing at all.
GOTUN_MARK_IFACE=br-lan

# Hosts whose own traffic is never classified, matched on source address.
# Comma-separated, bare addresses allowed.
#
# This is what a port-forwarded server needs. Classification looks at the
# destination, and the destination of a reply is whoever connected -- usually
# non-direct -- so the reply leaves via the exit hop and reaches that peer from
# an address it never dialled. The connection then never establishes while the
# port forward itself looks perfectly correct.
#
# The trade is that such a host loses the tunnel for its own outbound traffic
# too. For a game server that is the point: it should be reachable, and listed,
# at the address players actually dial.
GOTUN_DIRECT_SRC=

# open: if the tunnel is unusable, marked traffic takes the uplink. Nothing
# breaks, and nothing tells you either -- geo-blocked sites simply behave as if
# you were back on the ISP, so check egress identity to detect it.
# closed: blackhole it instead.
GOTUN_FAIL_MODE=open

# Health probe. TCP, not ICMP: sing-box answers pings locally from its own
# stack, so a ping through the tunnel succeeds even when the tunnel is dead.
GOTUN_PROBE_TARGET=1.1.1.1:443
GOTUN_PROBE_INTERVAL=60s
GOTUN_FAIL_AFTER=3
GOTUN_RECOVER_AFTER=2
GOTUN_IPV6=off

# auto: classify IPv6 like IPv4, but only when it can actually work -- the peer
#   must carry IPv6 and the prefix list must contain IPv6 entries. This is the
#   default. On this router the tunnel belongs to netifd, so gotun probes the
#   live device: add the IPv6 Address and AllowedIPs to the UCI wireguard
#   section, or IPv6 stays unclassified.
# on:  classify IPv6 regardless of what the peer advertises.
# off: leave IPv6 entirely alone.
GOTUN_IPV6=auto

# What non-direct IPv6 does when the tunnel cannot carry it.
# direct (default): it egresses the uplink. Nothing breaks, and every
#   IPv6-capable destination sees your real address -- clients prefer IPv6 when
#   both families resolve, so this is the usual path rather than a corner case.
#   apply warns every time this engages.
# blackhole: drop it in the routing table instead. Choose this if being seen
#   matters more than IPv6 working.
# drop: drop it in prerouting.
GOTUN_IPV6_FALLBACK=direct

# Turning IPv6 classification on writes net.ipv6.conf.all.forwarding=1. The
# kernel then ignores Router Advertisements on any interface still at
# accept_ra=1, so if the WAN address comes from SLAAC set accept_ra=2 on it
# (UCI: option accept_ra '2' on the wan6 interface) or the router loses its own
# IPv6 default route.
