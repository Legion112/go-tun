# Sourced by /etc/init.d/gotun. Shell syntax, no export needed.

# Collapsed CIDR list of destinations that go direct, out the ISP.
GOTUN_PREFIXES=/etc/gotun/prefixes.txt

# Underlay address(es) of the WireGuard peer, excluded from marking so the
# tunnel cannot try to carry its own handshake. Comma-separated: a dual-stack
# peer reachable over both families needs both listed, or the IPv6 classifier
# marks the tunnel's own encapsulated packets.
# Both the XRay server and any other tunnel endpoint must be listed, or the
# router will classify a neighbouring tunnel's own packets and route them into
# this one. Comma-separated.
GOTUN_ENDPOINT=185.80.130.211

# The tun sing-box creates.
GOTUN_TUNNEL_IFACE=xray0

# Local CIDRs, excluded from marking. List the IPv6 prefix here too once the
# LAN has one, or inbound WireGuard peers are not isolated from it.
GOTUN_LAN=192.168.8.0/24

# Only classify traffic arriving on these interfaces. Leaving this empty
# classifies traffic from ANY interface, including WAN-inbound. Add br-iot or a
# guest bridge here the day it is enabled, or those clients silently get no
# split routing at all.
GOTUN_MARK_IFACE=br-lan

# Inbound clients-facing devices gotun does not own, comma-separated: netifd's
# WireGuard interface, the xfrm interface an IKEv2 CHILD_SA surfaces on, or
# both at once. gotun holds no credential for them.
#
# Each must also appear in GOTUN_MARK_IFACE -- apply refuses otherwise, because
# a clients interface missing from the ingress guard means those clients are
# never classified and follow the ISP while everybody else is tunnelled, with
# nothing anywhere reporting it.
GOTUN_CLIENTS_IFACE=ipsec0

# Serves GET /alive: 200 while the tunnel carries traffic, 503 once the
# watchdog has withdrawn the route. It exists for a phone's IKEv2 On-Demand
# URLStringProbe, so the phone connects only when the exit hop actually works
# rather than when a web server happens to be up.
#
# Bound to the WAN address rather than 0.0.0.0 because uhttpd owns
# 127.0.0.1:8443 on this box. Published through the NATs in front of the
# router, so the body says only "up" or "down".
GOTUN_HEALTH_LISTEN=192.168.1.10:8443

# Read by /etc/init.d/gotun-ipsec, which creates the xfrm interface above.
# The address is load-bearing: charon installs no route for an xfrm interface,
# so without an on-link prefix every reply to a client fails source address
# selection while the SA still reads ESTABLISHED.
GOTUN_IPSEC_IFACE=ipsec0
GOTUN_IPSEC_IFID=0x61
GOTUN_IPSEC_ADDR=10.231.17.1/24
GOTUN_IPSEC_MTU=1400

# The parent device is only a hint to the kernel -- the if_id is what binds SAs
# to the interface -- so lo is deliberate. Naming the WAN device would be wrong
# the moment ESP arrives somewhere else, such as from a client already on the
# home LAN.
GOTUN_IPSEC_PARENT=lo

# ---------------------------------------------------------------------------
# The IKEv2 gateway, as a phone's configuration profile describes it.
#
# Read by `gotun ikev2` and by every `gotun ikev2 user` subcommand, so issuing a
# credential is `gotun ikev2 user add <name> -config /etc/gotun/gotun.conf` and
# not that plus a dozen flags repeating the same gateway. Every repetition was a
# chance to describe a gateway slightly unlike the one running -- which produces
# a profile that installs cleanly and then does not connect.
#
# Note there is no GOTUN_IKEV2_IFID: the interface id is GOTUN_IPSEC_IFID above,
# because it is one number. A connection and a device carrying different if_ids
# negotiate perfectly and then deliver packets nowhere.

# The address the phone dials, which must be reachable from the internet and
# must appear in the gateway certificate's SANs. Not GOTUN_ENDPOINT -- that is
# the tunnel's own peer, a different machine entirely.
GOTUN_IKEV2_SERVER=203.0.113.10

# The identity the gateway presents, and the certificate's CN. The phone checks
# the certificate against this name, so the two cannot drift.
GOTUN_IKEV2_GATEWAY_ID=vpn.home

# The virtual network clients land on. The gateway address is what the pool
# pushes as the phone's resolver, so it has to be inside the subnet and has to
# be the address gotun-dns is reachable on from the tunnel.
GOTUN_IKEV2_VIP_SUBNET=10.231.17.0/24
GOTUN_IKEV2_VIP_GATEWAY=10.231.17.1
GOTUN_IKEV2_POOL=10.231.17.16/28

# Which address families to emit traffic selectors for. Leaving IPv6 out means
# the phone keeps its IPv6 on the carrier, and every IPv6-capable destination
# sees its real address -- on an IPv6-only mobile network that is most of the
# traffic.
GOTUN_IKEV2_FAMILIES=v4

# Destinations the phone must never tunnel, so its own LAN keeps working.
# Empty means the built-in private, CGNAT, link-local, loopback and multicast
# space, which is what you want.
GOTUN_IKEV2_NON_ROUTABLE=

# The CA to put in the profile, as a trust payload. Without it a self-signed
# gateway is rejected with a generic connect error that says nothing about
# trust.
GOTUN_IKEV2_CA=/etc/swanctl/x509ca/gotun-ca.pem

# The gateway certificate, only needed when the profile should pin it rather
# than trust the CA for any name. Empty is the usual case.
GOTUN_IKEV2_SERVER_CERT=

# What the phone fetches over its physical interface to decide whether to
# connect -- `gotun watch -health-listen` on the gateway's PUBLIC address,
# published through every NAT in front of it. Without it the profile connects
# unconditionally and can sit in "connecting" against a gateway that is down.
GOTUN_IKEV2_PROBE_URL=http://203.0.113.10:8443/alive

# Wi-Fi networks on which not to connect, comma-separated. List every SSID
# served by this router, including guest ones: the tunnel would otherwise
# hairpin out and back through the same uplink, and an upstream router without
# NAT hairpin cannot do that at all, so the phone just fails to connect at home.
GOTUN_IKEV2_HOME_SSID=HomeWiFi,HomeWiFi-5G

# Which DNS queries the phone sends to the gateway's resolver. A split tunnel is
# not the default route, so iOS treats the pushed resolver as supplemental and
# consults it only for domains named here -- "none" means it is configured and
# then never used, which is measurably what happens.
GOTUN_IKEV2_DNS_MATCH=all

# DeadPeerDetectionRate: None, Low (30m), Medium (10m) or High (1m). This is
# also the fail-open latency, so it trades battery against availability.
GOTUN_IKEV2_DPD=High

# Let iOS bring the tunnel up by itself. false ships a profile connected by
# hand, which is the right first test against a gateway whose reachability is
# not yet proven.
GOTUN_IKEV2_ON_DEMAND=true

# NAT keepalive, in seconds. Below the shortest NAT timeout in the path, or the
# mapping is dropped and the phone goes quiet until it next sends something.
GOTUN_IKEV2_KEEPALIVE=110

# What the VPN entry is called on the phone, and the reverse-DNS prefix of the
# payload identifiers. The identifier decides the profile's UUID, so keeping it
# stable is what lets a reissued profile install over the old one instead of
# beside it.
GOTUN_IKEV2_NAME=gotun
GOTUN_IKEV2_IDENTIFIER=

# Where the per-user credential snippets live. swanctl includes conf.d/*.conf,
# which is what makes one file per user possible.
GOTUN_IKEV2_USER_DIR=/etc/swanctl/conf.d

# Hosts whose own traffic is never classified, matched on source address.
# Comma-separated, bare addresses allowed.
#
# This is what a port-forwarded server needs. Classification looks at the
# destination, and the destination of a reply is whoever connected -- usually
# non-direct -- so the reply leaves via the exit hop and reaches that peer from
# an address it never dialled. The connection then never establishes while the
# port forward itself looks perfectly correct.
#
# The trade is that such a host loses the tunnel for its own outbound traffic
# too. For a game server that is the point: it should be reachable, and listed,
# at the address players actually dial.
GOTUN_DIRECT_SRC=

# open: if the tunnel is unusable, marked traffic takes the uplink. Nothing
# breaks, and nothing tells you either -- geo-blocked sites simply behave as if
# you were back on the ISP, so check egress identity to detect it.
# closed: blackhole it instead.
GOTUN_FAIL_MODE=open

# Health probe. TCP, not ICMP: sing-box answers pings locally from its own
# stack, so a ping through the tunnel succeeds even when the tunnel is dead.
GOTUN_PROBE_TARGET=1.1.1.1:443
GOTUN_PROBE_INTERVAL=60s
GOTUN_FAIL_AFTER=3
GOTUN_RECOVER_AFTER=2

# auto: classify IPv6 like IPv4, but only when it can actually work -- the peer
#   must carry IPv6 and the prefix list must contain IPv6 entries. This is the
#   default. On this router the tunnel belongs to netifd, so gotun probes the
#   live device: add the IPv6 Address and AllowedIPs to the UCI wireguard
#   section, or IPv6 stays unclassified.
# on:  classify IPv6 regardless of what the peer advertises.
# off: leave IPv6 entirely alone.
GOTUN_IPV6=auto

# What non-direct IPv6 does when the tunnel cannot carry it.
# direct (default): it egresses the uplink. Nothing breaks, and every
#   IPv6-capable destination sees your real address -- clients prefer IPv6 when
#   both families resolve, so this is the usual path rather than a corner case.
#   apply warns every time this engages.
# blackhole: drop it in the routing table instead. Choose this if being seen
#   matters more than IPv6 working.
# drop: drop it in prerouting.
GOTUN_IPV6_FALLBACK=direct

# Turning IPv6 classification on writes net.ipv6.conf.all.forwarding=1. The
# kernel then ignores Router Advertisements on any interface still at
# accept_ra=1, so if the WAN address comes from SLAAC set accept_ra=2 on it
# (UCI: option accept_ra '2' on the wan6 interface) or the router loses its own
# IPv6 default route.
