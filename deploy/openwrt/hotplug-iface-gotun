#!/bin/sh
#
# Installed as BOTH /etc/hotplug.d/iface/99-gotun and
# /etc/hotplug.d/net/99-gotun, because the two kinds of event are not
# interchangeable and only one of them exists on this deployment:
#
#   iface  ACTION=ifup  INTERFACE=<UCI section>  DEVICE=<device>
#   net    ACTION=add   INTERFACE=<device>       DEVICE=<empty>
#
# A device created outside netifd -- which is exactly how sing-box makes its tun
# -- produces no iface event at all. For as long as this lived in iface/ alone
# it was never invoked here. Measured in the deploy lab against real netifd.
#
# Every decision lives in `gotun hotplug`: which event matters, which interface,
# whether anything is running to re-apply. This file is plumbing, and the pipe
# into logger is the only reason it is not a symlink -- netifd discards a hook's
# output, and an operator looking for this goes to logread.
#
# $ACTION and $INTERFACE are netifd's, read straight from the environment.
/usr/bin/gotun hotplug -config /etc/gotun/gotun.conf 2>&1 | logger -t gotun
