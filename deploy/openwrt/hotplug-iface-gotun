#!/bin/sh
#
# Installed as /etc/hotplug.d/iface/99-gotun.
#
# Re-apply when the tunnel comes up. Boot order is the main reason: the init
# script can run before netifd has created the device, and gotun's route step
# needs it to exist. This also covers a tunnel bounce, after which the kernel has
# withdrawn the device route from table 100 and only a reapply puts it back.
#
# apply is idempotent and reports zero changes when there is nothing to do, so
# running it on every ifup of this interface is cheap.

[ "$ACTION" = ifup ] || exit 0

# Only when the service is actually enabled. Without this check the hook happily
# re-arms the policy on any ifup -- including an ifup done while debugging a
# broken tunnel, which is exactly how it silently put every LAN client back onto
# a dead path after the operator had torn the policy down on purpose.
/etc/init.d/gotun enabled 2>/dev/null || exit 0

CONF=/etc/gotun/gotun.conf
[ -f "$CONF" ] || exit 0
# shellcheck source=/dev/null
. "$CONF"

[ "$INTERFACE" = "${GOTUN_TUNNEL_IFACE:-wg-exit}" ] || exit 0

# Only when the service is actually running, which is a different question from
# `enabled` above: enabled means "starts at boot", so acting on that alone would
# revive a service the operator had stopped on purpose -- the same failure the
# enabled check was written to prevent, through a different door.
ubus -S call service list '{"name":"gotun"}' 2>/dev/null \
	| grep -q '"running": *true' || exit 0

logger -t gotun "reapplying policy after ifup of $INTERFACE"

# restart, not start. procd's start on an already-running service is a no-op, so
# `start` here did nothing at all and the re-apply this hook exists to perform
# never happened -- measured in the deploy lab. restart tears the policy down
# and rebuilds it, which leaves a brief window with no policy; traffic uses the
# uplink during it, which is better than a tunnel route that never comes back.
#
# The right fix is for the running watcher to be signalled to re-apply in place,
# which is what `gotun hotplug` will do once watch takes -config.
/etc/init.d/gotun restart
