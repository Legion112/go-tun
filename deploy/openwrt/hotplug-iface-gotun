#!/bin/sh
#
# Installed as /etc/hotplug.d/iface/99-gotun.
#
# Every decision lives in `gotun hotplug`: which event matters, which interface,
# whether anything is running to re-apply. This file is plumbing, and the pipe
# into logger is the only reason it is not a symlink -- netifd discards a hook's
# output, and an operator looking for this goes to logread.
#
# $ACTION and $INTERFACE are netifd's, read straight from the environment.
/usr/bin/gotun hotplug -config /etc/gotun/gotun.conf 2>&1 | logger -t gotun
