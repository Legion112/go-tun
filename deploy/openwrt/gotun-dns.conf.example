# /etc/gotun/gotun-dns.conf -- read by /etc/init.d/gotun-dns.
#
# Sourced as root at boot, so it must contain assignments and comments only.
#
# Every value here has a default in the init script, so the file is optional and
# the service starts without it. It is documented because the defaults are not
# guessable, and because one of them deliberately disagrees with the binary's
# own default (see GOTUN_DNS_LISTEN).
#
# Why a second resolver at all: resolving a foreign name from here without the
# tunnel does not merely give a slower answer, it gives a *different* one --
# geo-localised at best, interfered with at worst. Routing the query through the
# tunnel is what makes the address the client finally connects to the right one.

# This is also gotun-dns's own default, so the line is here to document the
# reason rather than to change anything. The resolver is never the only one on a
# box -- it answers the subset of names that must go through the tunnel, and
# something else has to forward to it. Here that is dnsmasq, which owns :53 and
# serves DHCP.
#
#   uci add_list dhcp.@dnsmasq[0].server=127.0.0.2
#   uci commit dhcp && /etc/init.d/dnsmasq reload
GOTUN_DNS_LISTEN=127.0.0.2:53

# Upstream for names in the direct class, queried without a mark so the query
# egresses the local uplink. A resolver in the same country as the client is the
# point -- that is what makes the answer the local one.
GOTUN_DNS_DIRECT=77.88.8.8:53

# Upstream for everything else, dialed with SO_MARK so the query is steered into
# table 100 and leaves through the tunnel.
GOTUN_DNS_EXIT=1.1.1.1:53

# Must match the mark gotun classifies with, or the queries marked here are not
# the ones table 100 picks up and DNS quietly stops being tunnelled. Both sides
# default to this value; change neither alone.
GOTUN_DNS_MARK=0x1

# --- read by gotun dnswatch (/etc/init.d/gotun-dnswatch) --------------------
#
# The watcher reads GOTUN_DNS_LISTEN above as the resolver to probe and
# GOTUN_DNS_DIRECT as the last resort, which it never removes. The two below are
# its own.

# A blocking resolver in front of gotun-dns -- AdGuard Home at 127.0.0.1:3053,
# with gotun-dns as its only upstream. It is dnsmasq's first server while it
# answers and is dropped while it does not, so a dead blocker costs ad blocking
# and nothing else. Empty, the default, means there is no blocker and the list
# is gotun-dns then GOTUN_DNS_DIRECT, as before.
#
#   GOTUN_DNS_FILTER=127.0.0.1:3053
GOTUN_DNS_FILTER=

# The list the watcher writes, as server= lines, and dnsmasq reads:
#
#   uci -q delete dhcp.@dnsmasq[0].server
#   uci set dhcp.@dnsmasq[0].serversfile=/etc/gotun/dnsmasq.servers
#
# Under /etc/gotun so that it survives a reboot -- dnsmasq starts long before
# the watcher and must find a working list waiting -- and written only when it
# changes.
GOTUN_DNS_SERVERS_FILE=/etc/gotun/dnsmasq.servers
